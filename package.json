{
  "name": "bosye-website",
  "version": "1.0.0",
  "private": true,
  "description": "北京博士园官网与权限管理后台",
  "engines": {
    "node": ">=18.20"
  },
  "scripts": {
    "start": "node server/index.js",
    "start:local": "node scripts/local-service.mjs start",
    "restart:local": "node scripts/local-service.mjs restart",
    "stop:local": "node scripts/local-service.mjs stop",
    "dev": "node --watch server/index.js",
    "setup": "node server/setup.js",
    "test": "node --test tests/api.test.js tests/public-content.test.js tests/news.test.js tests/import.test.js",
    "test:browser": "node tests/browser.mjs",
    "test:icons": "node tests/arrow-icons.mjs",
    "test:login": "node tests/login-recovery.mjs",
    "test:media": "node tests/media-picker.mjs",
    "test:a11y": "node tests/accessibility.mjs",
    "format": "prettier --write \"*.{html,css,js,json,md}\" \"server/*.js\" \"tests/*.{js,mjs}\" \"docs/*.md\"",
    "backup": "node server/backup.js",
    "import:news": "node scripts/import-news-history.mjs",
    "test:design": "node tests/design-review.mjs",
    "test:readiness-pages": "node tests/readiness-pages.mjs",
    "audit:readiness": "node scripts/audit-local-https.mjs",
    "test:content": "node tests/content-editor.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "linkedom": "0.18.12",
    "multer": "^2.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.10"
  }
}
