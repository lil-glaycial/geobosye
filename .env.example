# 通过进程管理器、容器或 shell 注入环境变量，应用不自动读取此文件。
PORT=4173
HOST=127.0.0.1
NODE_ENV=development
# 仅在位于单层可信反向代理后时设置为 1。
TRUST_PROXY=0
# 生产环境设为实际 HTTPS 主域名，仅填写协议、域名和可选端口。
# PUBLIC_ORIGIN=https://www.example.com
# DATA_DIR=/absolute/path/to/bosye-data
# 本机需要同时支持 IPv6 localhost 时可选。
# LOCAL_IPV6=1
# Node 直接提供 HTTPS 时成对配置；使用 Nginx 终止 TLS 则留空。
# TLS_CERT_FILE=/absolute/path/to/fullchain.pem
# TLS_KEY_FILE=/absolute/path/to/privkey.pem
# 以下仅用于首次初始化，不能重置已有账号。
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=初始化时可选，省略则生成随机密码
